head
  meta(charset='utf-8')
  meta(name='viewport', content='width=device-width, initial-scale=1')
  //- Content Security Policy: everything is served from this site.
  //- If you add a CDN, a font host or an analytics script, list its origin in the
  //- matching directive (script-src, style-src, font-src, connect-src...).
  //- data: in img-src is required by Bootstrap's inline SVG icons.
  meta(http-equiv='Content-Security-Policy', content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'")
  meta(name='referrer', content='strict-origin-when-cross-origin')
  //- Placeholder favicon (empty, avoids the /favicon.ico 404). Replace with your own.
  link(rel='icon', href='data:,')

  block header

  //- Scripts
  include ./script-links/headscripts.pug
